{
  "manifest_version": 3,
  "name": "WlanMerge Download-Manager",
  "description": "Gibt große Downloads an WlanMerge weiter, damit sie über alle Leitungen gleichzeitig laden.",
  "version": "1.0.0",
  "key": "",
  "permissions": ["downloads", "cookies", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon128.png" }
}